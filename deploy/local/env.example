# 复制到仓库根目录的 .env（.env / .env.* 已被 .gitignore 忽略，不会入库）
#
# 生成 API_TOKEN：openssl rand -hex 24
API_TOKEN=change_me_generate_with_openssl
PANEL_PASSWORD=admin

TZ=Asia/Shanghai
# 面板端口（容器内固定 5310）
PANEL_PORT=5310
# 容器启动就立刻跑一轮（首次验证时可以临时设 true）
RUN_ON_START=false
# 每天几点跑（容器内 cron，TZ 生效）
CRON_SCHEDULE=0 7 * * *

# ── 账号（可选，也可以在面板「账号与会话」里添加）─────────────
# 面板添加的账号写在面板数据卷的 /opt/data/env.list，并会自动重建容器生效；
# 在这里写则随 docker compose 一起下发。两处保持一致，避免谁覆盖谁。
#ACCOUNT_1_EMAIL=you@outlook.com
#ACCOUNT_1_PASSWORD=
#ACCOUNT_1_TOTP_SECRET=
#ACCOUNT_1_GEO_LOCALE=cn

# ── 运行参数覆盖（可选）──────────────────────────────────────
#CONFIG_CLUSTERS=1
#CONFIG_REWARDS_MODE=maximize
